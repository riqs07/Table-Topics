# Copy this file to .env.local and fill in the values yourself.
# Never commit .env.local and never paste keys into chat.
# None of these may start with NEXT_PUBLIC_ (that would expose them in the browser).

# Coach feedback (needed from milestone 6)
ANTHROPIC_API_KEY=
# Whisper transcription fallback (only if chosen at checkpoint C5)
OPENAI_API_KEY=
# Passphrase that gates the AI routes (needed from milestone 6). At least 16 characters; a random
# one is best (`openssl rand -base64 24`). Type the same text into the app's Settings page.
APP_ACCESS_SECRET=
# Shared rate-limit store (Upstash Redis via the Vercel integration). Required in production;
# optional locally, where counters are kept in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# The voice that asks the small-talk questions (ElevenLabs). Optional: without them the phone's
# own voice reads the questions. Use a key limited to text to speech.
ELEVENLABS_API_KEY=
# The voice's ID from the ElevenLabs voice library (not secret).
ELEVENLABS_VOICE_ID=
# Deeper analysis (decision 91; optional). The transcription key (AssemblyAI). Set a spend cap in
# the AssemblyAI dashboard. Without it, the transcript part of deeper analysis is "not set up".
ASSEMBLYAI_API_KEY=
# The voice worker (voice-worker/README.md): its https address, and a shared secret of at least
# 16 characters set to the same value on the worker. Without both, the voice part is "not set up".
VOICE_WORKER_URL=
VOICE_WORKER_SECRET=
# Development only: the tunnel host the dev server accepts (for example my-name.trycloudflare.com,
# comma-separated for several). Empty means none; `pnpm phone` allows Cloudflare quick tunnels itself.
DEV_TUNNEL_HOST=
