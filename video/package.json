{
  "name": "voicelab-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare.mjs",
    "studio": "node scripts/prepare.mjs && remotion studio src/index.ts",
    "render": "node scripts/prepare.mjs && remotion render src/index.ts BuyABeat out/buy-a-beat.mp4",
    "still": "node scripts/prepare.mjs && remotion still src/index.ts BuyABeat out/still.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@remotion/cli": "4.0.539",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  }
}
