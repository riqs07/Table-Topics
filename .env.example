# Copy this file to .env.local and fill in the values yourself.
# Never commit .env.local and never paste keys into chat.
# None of these may start with NEXT_PUBLIC_ (that would expose them in the browser).

# Coach feedback (needed from milestone 6)
ANTHROPIC_API_KEY=
# Whisper transcription fallback (only if chosen at checkpoint C5)
OPENAI_API_KEY=
# Passphrase that gates the AI routes (needed from milestone 6)
APP_ACCESS_SECRET=
# Shared rate-limit store (Upstash Redis via the Vercel integration). Required in production;
# optional locally, where counters are kept in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
